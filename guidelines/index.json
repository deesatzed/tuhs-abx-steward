  "description": "Registry of all guideline files for TUHS Antibiotic Steward",

  "infections": {
    "uti": {
      "file": "infections/uti.json",
      "includes": ["cystitis", "pyelonephritis"],
      "critical_rules": [
        "Pyelonephritis requires IV antibiotics",
        "Fever + UTI = pyelonephritis = IV therapy"
      ],
      "status": "active"
    },
    "pneumonia": {
      "file": "infections/pneumonia.json",
      "includes": ["CAP", "HAP", "VAP", "Aspiration"],
